{
  "name": "@booqable/client",
  "version": "1.0.0",
  "description": "Official TypeScript/Node.js client library for the Booqable API",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src",
    "prepare": "npm run build"
  },
  "keywords": [
    "booqable",
    "api",
    "client",
    "typescript",
    "rental",
    "jsonapi"
  ],
  "author": "Booqable",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.13.5",
    "axios-retry": "^4.5.0",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^25.0.3",
    "@typescript-eslint/eslint-plugin": "^8.51.0",
    "@typescript-eslint/parser": "^8.46.3",
    "@vitest/coverage-v8": "^4.0.16",
    "eslint": "^9.39.2",
    "typescript": "^5.5.0",
    "vitest": "^4.0.7"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/booqable/booqable.js.git"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
