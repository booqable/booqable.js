{
  "name": "@booqable/client",
  "version": "2.1.0",
  "description": "JavaScript/TypeScript toolkit for the Booqable API. Zero-dependency port of the booqable.rb gem — works in Node.js, browsers, and edge runtimes such as Cloudflare Workers.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src test",
    "prepare": "npm run build"
  },
  "keywords": [
    "booqable",
    "api",
    "client",
    "typescript",
    "rental",
    "jsonapi"
  ],
  "author": "Booqable",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "typescript": "^5.5.0",
    "vitest": "^4.0.7"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/booqable/booqable.js.git"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
