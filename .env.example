# Booqable API Configuration
BOOQABLE_API_KEY=your_api_key_here
BOOQABLE_COMPANY_ID=your_company_id_here

# Optional: OAuth Configuration
BOOQABLE_CLIENT_ID=your_client_id_here
BOOQABLE_CLIENT_SECRET=your_client_secret_here

# Optional: API Configuration
BOOQABLE_API_DOMAIN=booqable.com
BOOQABLE_API_VERSION=4

# Optional: For OAuth examples
OAUTH_CODE=authorization_code_here
OAUTH_REDIRECT_URI=http://localhost:3000/callback
